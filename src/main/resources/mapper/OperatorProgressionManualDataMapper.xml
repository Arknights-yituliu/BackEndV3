<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lhs.mapper.survey.OperatorProgressionManualDataMapper">

    <!-- 覆盖保存和最新数据选择只需要时间信息，避免读取完整的干员练度 JSON。 -->
    <select id="getTimeInfoByAkUid" resultType="com.lhs.entity.po.survey.OperatorProgressionManualData">
        SELECT ak_uid, create_time, update_time
        FROM operator_progression_manual_data
        WHERE ak_uid = #{akUid}
    </select>

</mapper>
